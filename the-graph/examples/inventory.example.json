      "cli_container": "cli",
      "staking_address": "0x0000000000000000000000000000000000000001",
      "operator_address": "0x0000000000000000000000000000000000000002",
      "public_endpoint": "https://index.example.com/",
      "status_url": "http://127.0.0.1:8030/graphql",
      "metrics": {
        "graph_node": "http://127.0.0.1:8040/metrics",
        "indexer_agent": "http://127.0.0.1:7300/metrics",
        "indexer_service": "http://127.0.0.1:7301/metrics",
        "indexer_tap": "http://127.0.0.1:7302/metrics"
      },
      "archive_rpc_label": "arbitrum-one-archive-primary",
      "expected_deployments": [
        "QmExampleDeploymentHash1111111111111111111111",
