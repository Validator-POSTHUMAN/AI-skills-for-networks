      ],
      "network_subgraph_deployment": "QmExampleNetworkSubgraphHash333333333333333",
      "allocation_rules": [
        {
          "deployment": "QmExampleDeploymentHash1111111111111111111111",
          "decision_basis": "always",
          "allocation_amount_grt": "250000",
