{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Validator-POSTHUMAN/AI-skills-for-networks/shentu/references/inventory.schema.json",
  "title": "Shentu validator operator inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["chain_id", "targets"],
  "properties": {
    "chain_id": {
      "type": "string",
      "const": "shentu-2.2"
    },
    "operator_label": {
      "type": "string",
      "description": "Human-readable operator or team label. Do not include secrets."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "service",
          "daemon",
          "home",
          "rpc_local",
          "valoper",
          "valcons"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Operator-local target label, moniker, or inventory name."
          },
          "host": {
            "type": "string",
            "description": "Host name, IP, or asset identifier."
          },
          "ssh_target": {
            "type": "string",
            "description": "Optional SSH target, for example user@example-host."
          },
          "local_execution": {
            "type": "boolean",
            "description": "Set true when commands should run on the current host."
          },
          "service": {
            "type": "string",
            "description": "Systemd service name."
          },
          "daemon": {
            "type": "string",
            "default": "shentud"
          },
          "home": {
            "type": "string",
            "default": "~/.shentud"
          },
          "rpc_local": {
            "type": "string",
            "format": "uri",
            "description": "RPC endpoint reachable from the target host."
          },
          "rpc_public": {
            "type": "string",
            "format": "uri",
            "description": "Optional public RPC endpoint for height comparison."
          },
          "valoper": {
            "type": "string",
            "pattern": "^shentuvaloper[0-9a-z]+$"
          },
          "valcons": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{40}$"
          },
          "cosmovisor": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "description": "Non-secret operator notes."
          }
        },
        "anyOf": [
          { "required": ["ssh_target"] },
          { "required": ["local_execution"] }
        ]
      }
    }
  }
}
