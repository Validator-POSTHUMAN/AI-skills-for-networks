{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Validator-POSTHUMAN/AI-skills-for-networks/celestia/references/inventory.schema.json",
  "title": "Celestia operator inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["chain_id", "targets"],
  "properties": {
    "chain_id": { "type": "string", "const": "celestia" },
    "operator_label": {
      "type": "string",
      "description": "Human-readable operator or team label. Do not include secrets."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "role", "service"],
        "properties": {
          "name": { "type": "string" },
          "role": {
            "type": "string",
            "enum": ["validator", "sentry", "fullnode", "archive", "public-rpc", "snapshot", "bridge", "full-storage", "light", "other"]
          },
          "host": { "type": "string" },
          "ssh_target": { "type": "string" },
          "local_execution": { "type": "boolean" },
          "service": { "type": "string" },
          "runtime": {
            "type": "string",
            "enum": ["systemd", "docker", "kubernetes", "binary", "managed", "other"]
          },
          "daemon": { "type": "string", "description": "Consensus daemon, usually celestia-appd." },
          "home": { "type": "string", "description": "Consensus home, usually ~/.celestia-app." },
          "data_dir": { "type": "string" },
          "rpc_local": { "type": "string", "format": "uri" },
          "rpc_public": { "type": "string", "format": "uri" },
          "api_public": { "type": "string", "format": "uri" },
          "grpc_public": { "type": "string" },
          "valoper": { "type": "string", "pattern": "^celestiavaloper[0-9a-z]+$" },
          "valcons": { "type": "string", "pattern": "^[0-9A-Fa-f]{40}$" },
          "valcons_bech32": { "type": "string", "pattern": "^celestiavalcons[0-9a-z]+$" },
          "cosmovisor": { "type": "boolean" },
          "da_node_type": { "type": "string", "enum": ["bridge", "full", "light"] },
          "node_store": { "type": "string", "description": "DA node store, for example ~/.celestia-bridge." },
          "bridge_rpc_local": {
            "type": "string",
            "format": "uri",
            "description": "DA node JSON-RPC endpoint, usually http://127.0.0.1:26658."
          },
          "core_rpc": { "type": "string", "format": "uri" },
          "core_grpc": { "type": "string" },
          "key_name": { "type": "string", "description": "Non-secret DA node key name." },
          "keyring_backend": { "type": "string", "description": "Keyring backend label; do not include passphrases." },
          "archival": { "type": "boolean" },
          "metrics_endpoint": { "type": "string" },
          "key_custody_ref": {
            "type": "string",
            "description": "Non-secret reference to custody model or internal runbook."
          },
          "notes": { "type": "string", "description": "Non-secret operator notes." }
        },
        "anyOf": [
          { "required": ["ssh_target"] },
          { "required": ["local_execution"] }
        ],
        "allOf": [
          {
            "if": {
              "properties": {
                "role": { "enum": ["validator", "sentry", "fullnode", "archive", "public-rpc", "snapshot"] }
              }
            },
            "then": { "required": ["daemon", "home", "rpc_local"] }
          },
          {
            "if": {
              "properties": {
                "role": { "enum": ["bridge", "full-storage", "light"] }
              }
            },
            "then": { "required": ["da_node_type", "node_store", "bridge_rpc_local"] }
          }
        ]
      }
    }
  }
}
