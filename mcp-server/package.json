{
  "name": "@posthuman/validator-skills-mcp",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "description": "Read-only MCP server for the public POSTHUMAN validator skills catalog.",
  "engines": {"node": ">=20"},
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "npm run build && node --test dist/test/*.test.js",
    "start:stdio": "node dist/src/stdio.js",
    "start:http": "node dist/src/http.js"
  },
  "dependencies": {
    "@modelcontextprotocol/express": "2.0.0",
    "@modelcontextprotocol/server": "2.0.0",
    "express": "5.2.1",
    "zod": "4.4.3"
  },
  "overrides": {
    "fast-uri": "4.1.1"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.0.0",
    "@types/express": "5.0.6",
    "@types/node": "26.1.1",
    "typescript": "7.0.2"
  }
}
