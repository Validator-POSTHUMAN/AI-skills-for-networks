limit_req_zone $binary_remote_addr zone=validator_skills_mcp:10m rate=30r/m;

server {
    listen 443 ssl http2;
    server_name skills.example.org;

    ssl_certificate /etc/letsencrypt/live/skills.example.org/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/skills.example.org/privkey.pem;

    client_max_body_size 256k;

    location = /healthz {
        proxy_pass http://127.0.0.1:3000/healthz;
        proxy_set_header Host $host;
    }

    location = /mcp {
        limit_req zone=validator_skills_mcp burst=10 nodelay;
        proxy_pass http://127.0.0.1:3000/mcp;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_read_timeout 60s;
        proxy_send_timeout 60s;
    }

    location / {
        return 404;
    }
}
