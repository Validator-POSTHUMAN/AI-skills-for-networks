[Unit]
Description=POSTHUMAN validator skills MCP
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=validator-skills-mcp
Group=validator-skills-mcp
WorkingDirectory=/opt/posthuman/validator-skills-mcp/current/mcp-server
EnvironmentFile=/etc/validator-skills-mcp.env
ExecStart=/usr/bin/node dist/src/http.js
Restart=on-failure
RestartSec=5s
NoNewPrivileges=true
PrivateDevices=true
PrivateTmp=true
ProtectControlGroups=true
ProtectHome=true
ProtectKernelLogs=true
ProtectKernelModules=true
ProtectKernelTunables=true
ProtectSystem=strict
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=true
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
