{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/Validator-POSTHUMAN/AI-skills-for-networks/axelar/references/inventory.schema.json",
  "title": "Axelar validator operator inventory",
  "type": "object",
  "additionalProperties": false,
  "required": ["chain_id", "targets"],
  "properties": {
    "chain_id": {
      "type": "string",
      "description": "Axelar chain ID, usually axelar-dojo-1 for mainnet."
    },
    "operator_label": {
      "type": "string",
      "description": "Human-readable operator or team label. Do not include secrets."
    },
    "targets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "node_service",
          "daemon",
          "home",
          "rpc_local",
          "valoper",
          "valcons",
          "broadcaster"
        ],
        "properties": {
          "name": {
            "type": "string",
            "description": "Operator-local target label, moniker, or inventory name."
          },
          "host": {
            "type": "string",
            "description": "Host name, IP, or asset identifier."
          },
          "ssh_target": {
            "type": "string",
            "description": "Optional SSH target, for example user@example-host."
          },
          "local_execution": {
            "type": "boolean",
            "description": "Set true when commands should run on the current host."
          },
          "node_service": {
            "type": "string",
            "description": "Systemd service for axelard consensus node."
          },
          "vald_service": {
            "type": "string",
            "description": "Systemd service for axelard vald-start, if supervised by systemd."
          },
          "tofnd_service": {
            "type": "string",
            "description": "Systemd service for tofnd, if supervised by systemd."
          },
          "daemon": {
            "type": "string",
            "default": "axelard"
          },
          "home": {
            "type": "string",
            "default": "~/.axelar"
          },
          "rpc_local": {
            "type": "string",
            "format": "uri",
            "description": "RPC endpoint reachable from the target host."
          },
          "rpc_public": {
            "type": "string",
            "format": "uri",
            "description": "Optional public RPC endpoint for height comparison."
          },
          "tofnd_host": {
            "type": "string",
            "default": "127.0.0.1"
          },
          "valoper": {
            "type": "string",
            "pattern": "^axelarvaloper[0-9a-z]+$"
          },
          "valcons": {
            "type": "string",
            "pattern": "^[0-9A-Fa-f]{40}$"
          },
          "broadcaster": {
            "type": "string",
            "pattern": "^axelar1[0-9a-z]+$"
          },
          "maintainer_chains": {
            "type": "array",
            "items": {
              "type": "string"
            },
            "description": "External chains this validator intentionally maintains."
          },
          "min_broadcaster_uaxl": {
            "type": "string",
            "pattern": "^[0-9]+$",
            "description": "Minimum acceptable broadcaster balance in uaxl."
          },
          "cosmovisor": {
            "type": "boolean"
          },
          "notes": {
            "type": "string",
            "description": "Non-secret operator notes."
          }
        },
        "anyOf": [
          { "required": ["ssh_target"] },
          { "required": ["local_execution"] }
        ]
      }
    }
  }
}
